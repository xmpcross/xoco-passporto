---
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import PostCard from "@/components/PostCard.astro";
import PhotoGallery from "@/components/PhotoGallery.astro";
import PostGallery from "@/components/PostGallery.astro";
import ShareCard from "@/components/ShareCard.astro";
import { authorHref, formatDate, postSlug, readingMinutes, relatedPosts, visiblePosts } from "@/lib/content";

export async function getStaticPaths() {
  const posts = visiblePosts(await getCollection("posts"));
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const author = await getEntry(post.data.author);
const allPosts = await getCollection("posts");
const related = relatedPosts(allPosts, post);

const galleryPhotos = post.data.gallery.map((photo) => ({
  src: photo.src,
  alt: photo.alt,
  caption: photo.caption ? `${photo.caption} Photo: ${photo.creditName} / Unsplash` : `Photo: ${photo.creditName} / Unsplash`,
}));
const galleryCredits = [...new Set(post.data.gallery.map((photo) => photo.creditName))];
const galleryCaption = `Photos: ${galleryCredits.join(", ")} / Unsplash`;

// An MDX post can place the gallery itself with `<Gallery />`; otherwise it follows the article.
Astro.locals.postGallery = { photos: galleryPhotos, caption: galleryCaption };
const galleryInBody = /<Gallery\s*\/>/.test(post.body ?? "");
---

<BaseLayout title={post.data.title} description={post.data.dek} image={post.data.cover.src.src} type="article">
  <div class="min-h-screen bg-background">
    <SiteHeader overlay />

    <main id="main-content">
      <article>
        <header class="relative flex min-h-[78svh] items-end overflow-hidden md:min-h-[86svh]">
          <Image
            src={post.data.cover.src}
            alt={post.data.cover.alt}
            widths={[640, 960, 1280, 1920, 2400]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-b from-ink/50 via-ink/15 to-ink/85"></div>
          <div class="relative z-10 mx-auto w-full max-w-5xl px-6 pb-10 pt-32 text-background md:pb-14 lg:px-10">
            <a href={`/blog/?category=${encodeURIComponent(post.data.category)}`} class="tag bg-background/95 hover:bg-background">
              {post.data.category}
            </a>
            <h1 class="mt-5 max-w-4xl font-display text-[2.5rem] leading-[1.04] sm:text-5xl md:text-6xl lg:text-7xl">
              {post.data.title}
            </h1>
            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-background/85 md:text-xl">{post.data.dek}</p>
            <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-background/25 pt-6 text-sm text-background/80">
              <a href={authorHref(author)} class="group flex items-center gap-3">
                <Image src={author.data.avatar.src} alt="" width={80} height={80} class="h-10 w-10 rounded-full object-cover" />
                <span class="font-semibold text-background group-hover:underline">{author.data.name}</span>
              </a>
              <span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></span>
              <span>{readingMinutes(post)} min read</span>
              <span>{post.data.location}</span>
            </div>
          </div>
        </header>
        <p class="mx-auto max-w-5xl px-6 pt-3 text-right text-xs text-muted-foreground lg:px-10">
          Cover: {post.data.cover.creditName} / Unsplash
        </p>

        <div class="prose-editorial mx-auto mt-10 max-w-[720px] px-6 md:mt-14 md:px-0">
          <Content components={{ Gallery: PostGallery }} />
        </div>

        {
          galleryPhotos.length > 0 && !galleryInBody && (
            <div class="mx-auto mt-14 max-w-6xl px-6 lg:px-10">
              <PhotoGallery photos={galleryPhotos} caption={galleryCaption} />
            </div>
          )
        }

        <div class="mx-auto mt-16 max-w-[720px] space-y-6 px-6 md:px-0">
          <ShareCard title={post.data.title} />

          <a href={authorHref(author)} class="group grid grid-cols-[4rem_1fr] gap-5 border border-border p-6 transition-colors hover:border-foreground/40 sm:grid-cols-[5rem_1fr]">
            <Image src={author.data.avatar.src} alt={author.data.avatar.alt} width={160} height={160} class="h-16 w-16 rounded-full object-cover sm:h-20 sm:w-20" />
            <div>
              <p class="meta">Written by</p>
              <p class="mt-0.5 font-display text-2xl leading-tight group-hover:text-primary">{author.data.name}</p>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted-foreground">{author.body}</p>
            </div>
          </a>
        </div>
      </article>

      <section class="mx-auto mt-24 max-w-7xl px-6 lg:mt-32 lg:px-10">
        <div class="flex items-end justify-between gap-6">
          <h2 class="font-display text-4xl leading-tight">Keep reading</h2>
          <a href="/blog/" class="shrink-0 text-sm font-semibold hover:text-primary">All stories <span aria-hidden="true">→</span></a>
        </div>
        <div class="mt-10 grid gap-x-8 gap-y-14 md:grid-cols-3">
          {related.map((p) => <PostCard post={p} />)}
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
