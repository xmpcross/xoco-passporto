---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import PostCard from "@/components/PostCard.astro";
import { categories } from "@/config/categories";
import { authorHref, destinationHref, formatDate, postHref, readingMinutes, visiblePosts } from "@/lib/content";

const allPosts = visiblePosts(await getCollection("posts"));
const destinations = await getCollection("destinations");
const authors = await getCollection("authors");

// The newest featured post leads the hero; the other featured posts get their own row.
const featuredPosts = allPosts.filter((p) => p.data.featured);
const featured = featuredPosts[0] ?? allPosts[0];
const picks = featuredPosts.filter((p) => p.id !== featured.id).slice(0, 3);
const shown = new Set([featured.id, ...picks.map((p) => p.id)]);
const latest = allPosts.filter((p) => !shown.has(p.id)).slice(0, 4);
const [lead, ...side] = latest;

const sections = categories
  .map((name) => {
    const inCategory = allPosts.filter((p) => p.data.category === name);
    return { name, count: inCategory.length, cover: inCategory[0]?.data.cover };
  })
  .filter((s) => s.count > 0 && s.cover);
---

<BaseLayout>
  <div class="min-h-screen bg-background text-foreground">
    <SiteHeader overlay />

    <main id="main-content">
      <section class="relative h-[92svh] min-h-[620px] w-full overflow-hidden">
        <Image
          src={featured.data.cover.src}
          alt=""
          widths={[640, 960, 1280, 1920, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-ink/45 via-ink/10 to-ink/80"></div>
        <div class="relative z-10 mx-auto flex h-full max-w-7xl flex-col justify-end px-6 pb-12 text-background lg:px-10 lg:pb-16">
          <span class="tag w-fit bg-background/95">{featured.data.category}</span>
          <h1 class="mt-5 max-w-5xl font-display text-[2.75rem] leading-[1.02] sm:text-6xl md:text-7xl lg:text-[5.25rem]">
            <a href={postHref(featured)} class="hover:underline hover:decoration-1 hover:underline-offset-8">{featured.data.title}</a>
          </h1>
          <div class="mt-8 grid gap-6 border-t border-background/25 pt-8 md:grid-cols-[1fr_auto] md:items-end md:gap-12">
            <div>
              <p class="max-w-2xl text-lg leading-relaxed text-background/85 md:text-xl">{featured.data.dek}</p>
              <p class="mt-3 text-sm text-background/70">
                {featured.data.location} · <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time> · {readingMinutes(featured)} min read
              </p>
            </div>
            <a href={postHref(featured)} class="btn w-fit bg-background text-ink hover:bg-sand" aria-label={`Read the story: ${featured.data.title}`}>
              Read the story <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-7xl px-6 pt-20 lg:px-10 lg:pt-28">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="flex flex-col justify-between gap-8 bg-sand/45 p-6 sm:col-span-2 lg:col-span-1 lg:p-8">
            <div>
              <h2 class="font-display text-4xl leading-[1.08] lg:text-[2.125rem] xl:text-4xl">Three cities I keep going back to</h2>
              <p class="mt-4 text-[0.9375rem] leading-relaxed text-muted-foreground">
                Guides edited on the ground and revisited every year.
              </p>
            </div>
            <a href="/guides/" class="inline-flex items-center gap-2 text-sm font-semibold hover:text-primary">
              All guides <span aria-hidden="true">→</span>
            </a>
          </div>
          {
            destinations.map((d) => (
              <a href={destinationHref(d)} class="group relative block aspect-[4/5] overflow-hidden bg-muted">
                <Image
                  src={d.data.cover.src}
                  alt=""
                  widths={[400, 600, 800, 1000]}
                  sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw"
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/10 to-transparent" />
                <div class="absolute inset-x-0 bottom-0 p-6 text-background">
                  <p class="text-sm text-background/75">{d.data.country}</p>
                  <h3 class="mt-1 font-display text-3xl leading-tight">{d.data.name}</h3>
                  <p class="mt-1 text-sm text-background/80">{d.data.tagline}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      {
        lead && (
          <section class="mx-auto max-w-7xl px-6 pt-24 lg:px-10 lg:pt-32">
            <div class="flex items-end justify-between gap-6">
              <h2 class="font-display text-4xl leading-tight md:text-5xl">Latest stories</h2>
              <a href="/blog/" class="shrink-0 text-sm font-semibold hover:text-primary">
                All stories <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-12">
              <div class="lg:col-span-7">
                <PostCard post={lead} size="lg" sizes="(max-width: 1023px) 100vw, 58vw" />
              </div>
              <ul class="divide-y divide-border border-y border-border lg:col-span-5">
                {side.map((post) => (
                  <li>
                    <a href={postHref(post)} class="group grid grid-cols-[6.5rem_1fr] gap-5 py-5 sm:grid-cols-[8rem_1fr]">
                      <span class="relative block aspect-square overflow-hidden bg-muted">
                        <Image
                          src={post.data.cover.src}
                          alt=""
                          widths={[256, 400]}
                          sizes="8rem"
                          loading="lazy"
                          class="h-full w-full object-cover transition-transform duration-[1200ms] group-hover:scale-105"
                        />
                      </span>
                      <span class="flex min-w-0 flex-col justify-center">
                        <span class="text-[0.8125rem] font-semibold text-primary">{post.data.category}</span>
                        <span class="mt-1 font-display text-xl leading-snug transition-colors group-hover:text-primary sm:text-[1.375rem]">
                          {post.data.title}
                        </span>
                        <span class="meta mt-2">
                          {post.data.location} · {readingMinutes(post)} min
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )
      }

      <section class="mt-24 bg-deep py-20 text-on-deep lg:mt-32 lg:py-24">
        <div class="mx-auto max-w-7xl px-6 lg:px-10">
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="font-display text-4xl leading-tight md:text-5xl">Read by the kind of trip</h2>
            <p class="mt-4 text-[1.0625rem] leading-relaxed text-on-deep/70">
              Long-form dispatches, never top-ten lists. Pick a thread and follow it.
            </p>
          </div>
          <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-5">
            {
              sections.map((s) => (
                <li class="max-md:last:odd:col-span-2">
                  <a href={`/blog/?category=${encodeURIComponent(s.name)}`} class="group relative block aspect-[3/4] overflow-hidden bg-on-deep/10 max-md:[li:last-child:nth-child(odd)_&]:aspect-[16/9]">
                    <Image
                      src={s.cover!.src}
                      alt=""
                      widths={[320, 480, 640]}
                      sizes="(max-width: 767px) 50vw, (max-width: 1023px) 33vw, 20vw"
                      loading="lazy"
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-ink/75 via-ink/5 to-transparent" />
                    <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-2 p-4">
                      <span class="font-display text-2xl leading-tight">{s.name}</span>
                      <span class="text-sm text-on-deep/70">{s.count}</span>
                    </div>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      {
        picks.length > 0 && (
          <section class="mx-auto max-w-7xl px-6 pt-24 lg:px-10 lg:pt-32">
            <div class="flex items-end justify-between gap-6">
              <div>
                <h2 class="font-display text-4xl leading-tight md:text-5xl">Featured stories</h2>
                <p class="mt-3 max-w-xl text-[1.0625rem] leading-relaxed text-muted-foreground">
                  Hand-picked from the archive, worth a slow read.
                </p>
              </div>
              <a href="/blog/" class="hidden shrink-0 text-sm font-semibold hover:text-primary sm:inline">
                All stories <span aria-hidden="true">→</span>
              </a>
            </div>
            <ul class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {picks.map((post) => (
                <li>
                  <a href={postHref(post)} class="group flex h-full flex-col border border-border bg-card transition-colors hover:border-foreground/40">
                    <span class="relative block aspect-[3/2] overflow-hidden bg-muted">
                      <Image
                        src={post.data.cover.src}
                        alt={post.data.cover.alt}
                        widths={[400, 600, 800, 1000]}
                        sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw"
                        loading="lazy"
                        class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.04]"
                      />
                      <span class="tag absolute left-3 top-3">{post.data.category}</span>
                    </span>
                    <span class="flex flex-1 flex-col p-6">
                      <span class="font-display text-[1.625rem] leading-[1.15] transition-colors group-hover:text-primary">{post.data.title}</span>
                      <span class="mt-3 line-clamp-3 text-[0.9375rem] leading-relaxed text-muted-foreground">{post.data.dek}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="mx-auto max-w-7xl px-6 pt-24 lg:px-10 lg:pt-32">
        <div class="flex items-end justify-between gap-6">
          <h2 class="font-display text-4xl leading-tight md:text-5xl">The writers</h2>
          <a href="/authors/" class="shrink-0 text-sm font-semibold hover:text-primary">
            Meet the masthead <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="mt-10 grid gap-4 md:grid-cols-3">
          {
            authors.map((a) => {
              const count = allPosts.filter((p) => p.data.author.id === a.id).length;
              return (
                <li>
                  <a href={authorHref(a)} class="group flex h-full gap-5 border border-border p-6 transition-colors hover:border-foreground/40">
                    <Image src={a.data.avatar.src} alt={a.data.avatar.alt} width={144} height={144} class="h-16 w-16 shrink-0 rounded-full object-cover" />
                    <span class="min-w-0">
                      <span class="block font-display text-2xl leading-tight group-hover:text-primary">{a.data.name}</span>
                      <span class="mt-1 block text-sm font-medium text-primary">{a.data.role}</span>
                      <span class="meta mt-2 block">
                        {a.data.location} · {count} {count === 1 ? "story" : "stories"}
                      </span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>

      <section class="mx-auto max-w-4xl px-6 pt-24 text-center lg:pt-32">
        <svg viewBox="0 0 32 24" width="40" height="30" class="mx-auto text-primary" fill="currentColor" aria-hidden="true">
          <path d="M0 24V14C0 6 4.5 1.3 12 0l1.4 3C9 4.4 7 7.4 7 11h6v13H0Zm19 0V14c0-8 4.5-12.7 12-14l1 3c-4.4 1.4-6.4 4.4-6.4 8H32v13H19Z" />
        </svg>
        <blockquote class="mt-8 font-display text-3xl leading-[1.2] md:text-5xl">
          A city you love is one you learn to be bored in — where the third coffee of the morning is more interesting
          than the first monument.
        </blockquote>
        <p class="mt-8 text-sm text-muted-foreground">
          From <a href={postHref(featured)} class="font-semibold text-foreground underline underline-offset-4 hover:text-primary">{featured.data.title}</a>,
          {" "}{formatDate(featured.data.date)}
        </p>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
