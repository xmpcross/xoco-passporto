---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import PostCard from "@/components/PostCard.astro";
import VideoPlayer from "@/components/VideoPlayer.astro";
import PhotoGallery from "@/components/PhotoGallery.astro";
import { destinationHref, destinationSlug, visiblePosts } from "@/lib/content";

const videoAssets = import.meta.glob("/src/content/destinations/*/*.mp4", {
  eager: true,
  query: "?url",
  import: "default",
}) as Record<string, string>;

export async function getStaticPaths() {
  const destinations = await getCollection("destinations");
  return destinations.map((destination) => ({
    params: { slug: destinationSlug(destination) },
    props: { destination },
  }));
}

const { destination: dest } = Astro.props;
const allDestinations = await getCollection("destinations");
const others = allDestinations.filter((d) => d.id !== dest.id);
const allPosts = visiblePosts(await getCollection("posts"));
const storiesFromHere = allPosts
  .filter((p) => p.data.location.toLowerCase().includes(dest.data.name.toLowerCase()))
  .slice(0, 3);

const photoEssay = (dest.data.photoEssay ?? []).map((photo) => ({
  src: photo.src,
  alt: photo.alt,
  caption: `${photo.alt}. Photo: ${photo.creditName} / Unsplash`,
}));
const essayCredits = [...new Set((dest.data.photoEssay ?? []).map((photo) => photo.creditName))];

const videoSrc = dest.data.video
  ? videoAssets[`/src/content/destinations/${destinationSlug(dest)}/${dest.data.video.src.replace(/^\.\//, "")}`]
  : undefined;

const essentials = [
  { title: "Things to do", items: dest.data.things.map((t) => ({ name: t, note: "" })) },
  { title: "Where to stay", items: dest.data.stay },
  { title: "Where to eat", items: dest.data.food },
];

const hasPractical = !!(dest.data.getting || dest.data.costs || dest.data.reads || dest.data.language);

const sections = [
  { id: "essentials", label: "Essentials", show: true },
  { id: "itinerary", label: "Itinerary", show: !!dest.data.itinerary?.length },
  { id: "neighbourhoods", label: "Neighbourhoods", show: !!dest.data.neighborhoods?.length },
  { id: "photos", label: "Photos", show: photoEssay.length > 0 },
  { id: "practical", label: "Practical", show: hasPractical },
  { id: "stories", label: "Stories", show: storiesFromHere.length > 0 },
].filter((s) => s.show);

const glance = [
  { label: "Best time to visit", value: dest.data.bestTime },
  dest.data.itinerary && { label: "Suggested stay", value: `${dest.data.itinerary.length} days, more if you can` },
  dest.data.getting?.[0] && { label: dest.data.getting[0].label, value: dest.data.getting[0].note },
].filter((g): g is { label: string; value: string } => Boolean(g));

const card = "border border-border bg-card p-6 md:p-7";
const sectionHead = "font-display text-4xl leading-[1.05] md:text-5xl";
---

<BaseLayout title={`${dest.data.name}, ${dest.data.country} — a travel guide`} description={dest.data.tagline} image={dest.data.cover.src.src}>
  <div class="min-h-screen bg-background">
    <SiteHeader overlay />

    <main id="main-content">
      <section class="relative flex min-h-[80svh] items-end overflow-hidden">
        <Image
          src={dest.data.cover.src}
          alt={dest.data.cover.alt}
          widths={[640, 960, 1280, 1920, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-ink/45 via-ink/10 to-ink/85"></div>
        <div class="relative z-10 mx-auto w-full max-w-7xl px-6 pb-12 pt-32 text-background lg:px-10 lg:pb-16">
          <p class="text-[0.9375rem] text-background/80">A travel guide to {dest.data.country}</p>
          <h1 class="mt-2 font-display text-7xl leading-[0.92] md:text-[8.5rem]">{dest.data.name}</h1>
          <p class="mt-5 max-w-xl text-xl text-background/90 md:text-2xl">{dest.data.tagline}</p>
        </div>
        <p class="absolute bottom-3 right-4 z-10 text-xs text-background/60 lg:right-6">
          Cover: {dest.data.cover.creditName} / Unsplash
        </p>
      </section>

      <nav class="sticky-bar z-30 border-b border-border bg-background" aria-label="Guide sections">
        <div class="no-scrollbar mx-auto flex max-w-7xl items-center gap-6 px-6 lg:px-10">
          <ul class="flex min-w-max gap-7">
            {
              sections.map((s) => (
                <li>
                  <a
                    href={`#${s.id}`}
                    data-guide-link={s.id}
                    class="relative block py-4 text-[0.9375rem] font-medium text-muted-foreground transition-colors hover:text-foreground aria-[current=true]:text-foreground aria-[current=true]:after:absolute aria-[current=true]:after:inset-x-0 aria-[current=true]:after:bottom-0 aria-[current=true]:after:h-0.5 aria-[current=true]:after:bg-foreground"
                  >
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>

      <section class="mx-auto max-w-7xl px-6 pt-16 lg:px-10 lg:pt-24">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <p class="font-display text-[1.75rem] leading-[1.3] md:text-[2.375rem] lg:col-span-7">{dest.data.intro}</p>
          <dl class="grid content-start gap-px bg-border lg:col-span-5">
            {
              glance.map((g) => (
                <div class="bg-sand/45 px-6 py-5 dark:bg-card">
                  <dt class="text-sm font-semibold">{g.label}</dt>
                  <dd class="mt-1 text-[0.9375rem] leading-relaxed text-muted-foreground">{g.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      {
        dest.data.video && videoSrc && (
          <figure class="mx-auto mt-16 max-w-7xl px-6 lg:mt-24 lg:px-10">
            <VideoPlayer src={videoSrc} poster={dest.data.video.poster.src.src} />
            <figcaption class="meta mt-3">
              {dest.data.video.caption} Video: {dest.data.video.creditName} / Pexels. Poster: {dest.data.video.poster.creditName} / Unsplash.
            </figcaption>
          </figure>
        )
      }

      <section id="essentials" class="mx-auto max-w-7xl scroll-mt-32 px-6 pt-24 lg:px-10 lg:pt-32">
        <h2 class={sectionHead}>The essentials</h2>
        <p class="mt-4 max-w-xl text-[1.0625rem] leading-relaxed text-muted-foreground">
          What to do, where to sleep, and where to eat, all of it checked on the ground this year.
        </p>
        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {
            essentials.map((group) => (
              <div class={card}>
                <h3 class="font-display text-2xl leading-tight">{group.title}</h3>
                <ul class="mt-5 divide-y divide-border">
                  {group.items.map((item) => (
                    <li class="py-3.5 first:pt-0 last:pb-0">
                      <p class:list={["text-[0.9375rem] leading-snug", item.note && "font-semibold"]}>{item.name}</p>
                      {item.note && <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{item.note}</p>}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      {
        dest.data.itinerary && (
          <section id="itinerary" class="mx-auto max-w-7xl scroll-mt-32 px-6 pt-24 lg:px-10 lg:pt-32">
            <h2 class={sectionHead}>{dest.data.itinerary.length} days in {dest.data.name}</h2>
            <p class="mt-4 max-w-xl text-[1.0625rem] leading-relaxed text-muted-foreground">
              An unhurried first visit, one neighbourhood at a time.
            </p>
            <ol class="mt-12 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-6">
              {dest.data.itinerary.map((it) => (
                <li class="relative border-t-2 border-foreground pt-5">
                  <span aria-hidden="true" class="absolute -top-[7px] left-0 h-3 w-3 bg-primary" />
                  <p class="text-sm font-semibold text-primary">{it.day}</p>
                  <p class="mt-2 font-display text-2xl leading-tight">{it.title}</p>
                  <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted-foreground">{it.note}</p>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        dest.data.neighborhoods && (
          <section id="neighbourhoods" class="mt-24 scroll-mt-32 bg-deep py-20 text-on-deep lg:mt-32 lg:py-24">
            <div class="mx-auto max-w-7xl px-6 lg:px-10">
              <h2 class={sectionHead}>Where to point your feet</h2>
              <p class="mt-4 max-w-xl text-[1.0625rem] leading-relaxed text-on-deep/70">
                Each worth a full day. Walk them in this order if you have the time.
              </p>
              <ul class="mt-12 grid gap-px bg-on-deep/15 sm:grid-cols-2 lg:grid-cols-4">
                {dest.data.neighborhoods.map((n) => (
                  <li class="bg-deep p-6 lg:p-7">
                    <p class="font-display text-3xl leading-tight">{n.name}</p>
                    <p class="mt-3 text-[0.9375rem] leading-relaxed text-on-deep/70">{n.note}</p>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )
      }

      {
        photoEssay.length > 0 && (
          <section id="photos" class="mx-auto max-w-7xl scroll-mt-32 px-6 pt-24 lg:px-10 lg:pt-32">
            <h2 class={sectionHead}>{dest.data.name} in pictures</h2>
            <div class="mt-10">
              <PhotoGallery photos={photoEssay} caption={`Photos: ${essayCredits.join(", ")} / Unsplash`} />
            </div>
          </section>
        )
      }

      {hasPractical && (
      <section id="practical" class="mx-auto max-w-7xl scroll-mt-32 px-6 pt-24 lg:px-10 lg:pt-32">
        <h2 class={sectionHead}>Before you go</h2>
        <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {
            dest.data.getting && (
              <div class:list={[card, "lg:row-span-2"]}>
                <h3 class="font-display text-2xl leading-tight">Getting around</h3>
                <ul class="mt-5 space-y-5">
                  {dest.data.getting.map((g) => (
                    <li>
                      <p class="text-[0.9375rem] font-semibold">{g.label}</p>
                      <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{g.note}</p>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          {
            dest.data.costs && (
              <div class={card}>
                <h3 class="font-display text-2xl leading-tight">What things cost</h3>
                <ul class="mt-4 divide-y divide-border text-[0.9375rem]">
                  {dest.data.costs.map((c) => (
                    <li class="flex items-baseline justify-between gap-4 py-2.5">
                      <span>{c.label}</span>
                      <span class="font-semibold tabular-nums">{c.value}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          {
            dest.data.language && (
              <div class={card}>
                <h3 class="font-display text-2xl leading-tight">A little language</h3>
                <ul class="mt-5 space-y-4">
                  {dest.data.language.map((l) => (
                    <li>
                      <p class="font-display text-lg leading-tight">{l.phrase}</p>
                      <p class="mt-0.5 text-sm text-muted-foreground">{l.meaning}</p>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          {
            dest.data.reads && (
              <div class:list={[card, "bg-sand/45 md:col-span-2 dark:bg-card"]}>
                <h3 class="font-display text-2xl leading-tight">To read before you go</h3>
                <ul class="mt-5 grid gap-5 sm:grid-cols-3">
                  {dest.data.reads.map((r) => (
                    <li>
                      <p class="font-display text-lg leading-tight">{r.title}</p>
                      <p class="mt-1 text-sm text-muted-foreground">{r.author}</p>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </section>
      )}

      {
        storiesFromHere.length > 0 && (
          <section id="stories" class="mx-auto max-w-7xl scroll-mt-32 px-6 pt-24 lg:px-10 lg:pt-32">
            <div class="flex items-end justify-between gap-6">
              <h2 class={sectionHead}>Stories from {dest.data.name}</h2>
              <a href="/blog/" class="shrink-0 text-sm font-semibold hover:text-primary">All stories <span aria-hidden="true">→</span></a>
            </div>
            <div class="mt-10 grid gap-x-8 gap-y-14 md:grid-cols-3">
              {storiesFromHere.map((p) => <PostCard post={p} />)}
            </div>
          </section>
        )
      }

      <section class="mx-auto max-w-7xl px-6 pt-24 lg:px-10 lg:pt-32">
        <div class="flex items-end justify-between gap-6">
          <h2 class={sectionHead}>More guides</h2>
          <a href="/guides/" class="shrink-0 text-sm font-semibold hover:text-primary">All guides <span aria-hidden="true">→</span></a>
        </div>
        <div class="mt-10 grid gap-4 md:grid-cols-2">
          {
            others.map((d) => (
              <a href={destinationHref(d)} class="group relative block aspect-[16/10] overflow-hidden bg-muted">
                <Image
                  src={d.data.cover.src}
                  alt=""
                  widths={[480, 720, 960, 1280]}
                  sizes="(max-width: 767px) 100vw, 50vw"
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/10 to-transparent" />
                <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-6 text-background md:p-8">
                  <div>
                    <p class="text-sm text-background/75">{d.data.country}</p>
                    <h3 class="mt-1 font-display text-4xl leading-none">{d.data.name}</h3>
                    <p class="mt-2 text-[0.9375rem] text-background/80">{d.data.tagline}</p>
                  </div>
                  <span aria-hidden="true" class="grid h-11 w-11 shrink-0 place-items-center border border-background/40 transition-colors group-hover:bg-background group-hover:text-ink">→</span>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<script>
  // Mark the section in view in the sticky guide nav.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-guide-link]"));
  const targets = links
    .map((link) => document.getElementById(link.dataset.guideLink ?? ""))
    .filter((el): el is HTMLElement => !!el);

  if (links.length && "IntersectionObserver" in window) {
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        });
        const current = targets.find((t) => visible.has(t.id))?.id;
        links.forEach((link) => link.setAttribute("aria-current", String(link.dataset.guideLink === current)));
      },
      { rootMargin: "-30% 0px -60% 0px" },
    );
    targets.forEach((t) => observer.observe(t));
  }
</script>
