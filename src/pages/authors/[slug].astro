---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import PostCard from "@/components/PostCard.astro";
import { authorHref, authorSlug, postsByAuthor, visiblePosts } from "@/lib/content";

export async function getStaticPaths() {
  const authors = await getCollection("authors");
  return authors.map((author) => ({ params: { slug: authorSlug(author) }, props: { author } }));
}

const PAGE_SIZE = 6;

const { author } = Astro.props;
const allAuthors = await getCollection("authors");
const others = allAuthors.filter((a) => a.id !== author.id);
const posts = postsByAuthor(visiblePosts(await getCollection("posts")), author.id);
const firstName = author.data.name.split(" ")[0];
---

<BaseLayout title={author.data.name} description={author.body} image={author.data.avatar.src.src}>
  <div class="min-h-screen bg-background">
    <SiteHeader />

    <main id="main-content">
    <section class="mx-auto max-w-6xl px-6 pt-20 lg:px-10 lg:pt-24">
      <a href="/authors/" class="text-sm font-medium text-muted-foreground hover:text-foreground">
        ← The masthead
      </a>
      <div class="mt-8 grid gap-10 md:grid-cols-[220px_1fr] md:items-center">
        <div class="h-40 w-40 overflow-hidden rounded-full border border-border md:h-52 md:w-52">
          <Image src={author.data.avatar.src} alt={author.data.avatar.alt} width={416} height={416} class="h-full w-full object-cover" />
        </div>
        <div>
          <p class="text-sm font-medium text-primary">{author.data.role}</p>
          <h1 class="mt-2 font-display text-5xl leading-[1] md:text-6xl">{author.data.name}</h1>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground">{author.body}</p>
          <p class="meta mt-4">Based in {author.data.location}</p>
          <p class="meta mt-1">
            Photo: {author.data.avatar.creditName} / Unsplash
          </p>
        </div>
      </div>
    </section>

    <section class="mx-auto mt-20 max-w-7xl px-6 lg:px-10">
      <div class="mb-8 flex items-end justify-between border-b border-border pb-4">
        <h2 class="font-display text-3xl md:text-4xl">
          {posts.length} {posts.length === 1 ? "story" : "stories"} by {firstName}
        </h2>
      </div>
      {
        posts.length === 0 ? (
          <p class="text-sm text-muted-foreground">
            No stories filed yet. Check back — {firstName}'s next dispatch is due soon.
          </p>
        ) : (
          <div class="grid gap-x-8 gap-y-16 md:grid-cols-3">
            {posts.map((p, i) => (
              <div data-card class={i >= PAGE_SIZE ? "hidden" : ""}>
                <PostCard post={p} />
              </div>
            ))}
          </div>
        )
      }
      {
        posts.length > PAGE_SIZE && (
          <div class="mt-16 flex justify-center">
            <button
              type="button"
              data-load-more
              class="btn border border-foreground/20 hover:border-foreground hover:bg-foreground hover:text-background"
            >
              Load more stories
            </button>
          </div>
        )
      }
    </section>

    <section class="mx-auto mt-24 max-w-7xl px-6 pb-4 lg:px-10">
      <h2 class="font-display text-3xl leading-tight">Also on the masthead</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {
          others.map((o) => (
            <a href={authorHref(o)} class="flex items-center gap-4 border border-border p-4 hover:border-primary">
              <div class="h-14 w-14 overflow-hidden rounded-full">
                <Image src={o.data.avatar.src} alt={o.data.avatar.alt} width={112} height={112} class="h-full w-full object-cover" />
              </div>
              <div>
                <p class="font-display text-xl leading-tight">{o.data.name}</p>
                <p class="text-xs text-muted-foreground">{o.data.role}</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>
    </main>
    <SiteFooter />
  </div>

  <script define:vars={{ pageSize: PAGE_SIZE }} is:inline>
    const loadMoreBtn = document.querySelector("[data-load-more]");
    const cards = Array.from(document.querySelectorAll("[data-card]"));

    let page = 1;

    loadMoreBtn?.addEventListener("click", () => {
      const firstNew = cards[page * pageSize];
      page += 1;

      const limit = page * pageSize;
      cards.forEach((card, i) => card.classList.toggle("hidden", i >= limit));

      const done = limit >= cards.length;
      loadMoreBtn.classList.toggle("hidden", done);
      if (done) firstNew?.querySelector("a")?.focus();
    });
  </script>
</BaseLayout>
