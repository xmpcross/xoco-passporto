---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { authorHref, postsByAuthor, visiblePosts } from "@/lib/content";

const authors = await getCollection("authors");
const posts = visiblePosts(await getCollection("posts"));
---

<BaseLayout title="Writers" description="The writers behind Passporto: a small, opinionated masthead of correspondents in Porto, Kyoto, and Lagos.">
  <div class="min-h-screen bg-background">
    <SiteHeader />
    <main id="main-content">
    <section class="mx-auto max-w-4xl px-6 pt-14 lg:pt-20">
      <h1 class="font-display text-5xl leading-[1] md:text-6xl">A small, opinionated masthead</h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground">
        Three writers, three cities, one editorial line: go slowly, look carefully, and don't file a story until
        you've eaten there twice.
      </p>
    </section>

    <section class="mx-auto mt-16 max-w-6xl px-6 pb-24 lg:px-10">
      <ul class="divide-y divide-border">
        {
          authors.map((a) => {
            const n = postsByAuthor(posts, a.id).length;
            return (
              <li>
                <a href={authorHref(a)} class="grid gap-6 py-10 md:grid-cols-[120px_1fr_auto] md:items-center">
                  <div class="h-24 w-24 overflow-hidden rounded-full border border-border md:h-28 md:w-28">
                    <Image src={a.data.avatar.src} alt={a.data.avatar.alt} width={224} height={224} class="h-full w-full object-cover" />
                  </div>
                  <div>
                    <p class="text-sm font-medium text-primary">{a.data.role}</p>
                    <h2 class="mt-1 font-display text-3xl leading-tight md:text-4xl">{a.data.name}</h2>
                    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted-foreground">{a.body}</p>
                  </div>
                  <div class="meta md:text-right">
                    <p>{a.data.location}</p>
                    <p class="mt-1">{n} {n === 1 ? "story" : "stories"}</p>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
