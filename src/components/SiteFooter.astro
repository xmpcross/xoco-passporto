---
import LocalIcon from "@/components/LocalIcon.astro";
import Newsletter from "@/components/Newsletter.astro";
import { siteConfig } from "@/config/site";
const year = new Date().getFullYear();

const columns = [
  {
    title: "Read",
    links: [
      { label: "All stories", href: "/blog/" },
      { label: "Destination guides", href: "/guides/" },
      { label: "Writers", href: "/authors/" },
      { label: "Colophon", href: "/colophon/" },
    ],
  },
  {
    title: "Contact",
    links: [
      { label: "About", href: "/about/" },
      { label: "Say hello", href: "/contact/" },
      { label: siteConfig.email, href: `mailto:${siteConfig.email}` },
    ],
  },
];
---

<footer class="mt-24 bg-deep text-on-deep lg:mt-32">
  <div class="mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-12 lg:px-10 lg:py-20">
    <div class="md:col-span-7 md:col-start-6 md:row-start-1 lg:col-span-6 lg:col-start-7">
      <Newsletter variant="footer" />
    </div>
    <nav class="grid grid-cols-2 gap-6 md:col-span-5 md:col-start-1 md:row-start-1 lg:col-span-4" aria-label="Footer">
      {
        columns.map((col) => (
          <div>
            <p class="text-sm font-semibold text-on-deep">{col.title}</p>
            <ul class="mt-4 space-y-2.5 text-[0.9375rem]">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} class="break-all text-on-deep/65 transition-colors hover:text-on-deep sm:break-normal">{l.label}</a>
                </li>
              ))}
            </ul>
            {col.title === "Contact" && (
              <ul class="mt-6 flex gap-1" aria-label="Follow Passporto">
                {siteConfig.socials.map((s) => (
                  <li>
                    <a
                      href={s.href}
                      aria-label={s.label}
                      title={s.label}
                      class="grid h-9 w-9 place-items-center border border-on-deep/20 text-on-deep/75 transition-colors hover:border-on-deep hover:bg-on-deep hover:text-deep"
                    >
                      <LocalIcon name={s.icon} className="h-4 w-4" />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </nav>
  </div>
  <div class="border-t border-on-deep/10">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-3 px-6 py-6 text-sm text-on-deep/50 md:flex-row md:items-center lg:px-10">
      <p>© {year} {siteConfig.name}. Photographs by their respective authors.</p>
      <p>An independent publication about slow travel.</p>
    </div>
  </div>
</footer>
