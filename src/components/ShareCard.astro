---
import ShareButton from "@/components/ShareButton.astro";
import ShareSheet from "@/components/ShareSheet.astro";
import { siteConfig } from "@/config/site";

/**
 * Closes a story with a way to pass it on. The button opens the phone's own
 * share sheet where there is one, and the page's `ShareSheet` everywhere else.
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
const url = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
---

<section
  aria-labelledby="share-card-title"
  class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4 border-y border-border py-6"
>
  <h2 id="share-card-title" class="font-display text-2xl leading-tight">Enjoyed the read? Pass it on</h2>
  <ShareButton title={title} url={url} class="bg-deep text-on-deep hover:bg-primary" />
</section>

<ShareSheet title={title} url={url} />
