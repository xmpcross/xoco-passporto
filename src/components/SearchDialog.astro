---
/**
 * Command palette, opened from the header, with Cmd/Ctrl+K or with "/".
 *
 * It rests on the field alone; rows appear once there is a query. The index
 * is fetched from `/search-index.json` on first use, so it never weighs on
 * the page itself.
 */
const kbd =
  "inline-grid h-5 min-w-5 place-items-center border border-border bg-muted px-1 text-[0.6875rem] font-medium text-foreground";
---

<dialog
  id="search-dialog"
  data-search-dialog
  aria-labelledby="search-dialog-title"
  class="m-0 h-[100dvh] max-h-none w-full max-w-none overflow-y-auto bg-transparent p-0 text-foreground backdrop:bg-ink/55 backdrop:backdrop-blur-sm"
>
  <div class="flex min-h-full items-start justify-center px-4 pt-[clamp(0.75rem,12vh,7rem)] pb-4">
    <form
      action="/search/"
      method="get"
      role="search"
      aria-label="Site search"
      data-search-panel
      class="w-full max-w-xl bg-background shadow-[0_30px_80px_-20px_oklch(0.14_0.006_240/0.4)] motion-safe:animate-command"
    >
      <div class="flex items-center gap-3 px-5">
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          class="shrink-0 text-muted-foreground"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="6.5" />
          <path d="m16.5 16.5 4 4" />
        </svg>
        <h2 id="search-dialog-title" class="sr-only">Search stories and guides</h2>
        <label class="sr-only" for="search-dialog-input">Search stories and guides</label>
        <input
          id="search-dialog-input"
          name="q"
          type="search"
          data-search-input
          placeholder="Search stories, guides, places"
          autocomplete="off"
          enterkeyhint="search"
          aria-describedby="search-dialog-summary"
          class="h-16 w-full min-w-0 bg-transparent text-lg outline-none placeholder:text-muted-foreground [&::-webkit-search-cancel-button]:hidden"
        />
        <button
          type="button"
          data-search-close
          aria-label="Close search"
          class="hidden shrink-0 sm:block"
        >
          <kbd class={kbd}>Esc</kbd>
        </button>
        <button
          type="button"
          data-search-close
          aria-label="Close search"
          class="grid h-9 w-9 shrink-0 place-items-center text-muted-foreground hover:text-foreground sm:hidden"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18" />
          </svg>
        </button>
      </div>

      <p id="search-dialog-summary" data-search-summary aria-live="polite" class="sr-only"></p>

      <div data-search-body hidden class="border-t border-border">
        <div class="max-h-[min(60vh,28rem)] overflow-y-auto overscroll-contain p-2">
          <div data-search-results class="grid grid-cols-[minmax(0,1fr)]"></div>
          <div data-search-empty hidden class="px-3 py-10 text-center">
            <p class="font-display text-xl leading-tight">No matches</p>
            <p class="mt-1 text-sm text-muted-foreground">Try a place, a title, or a category.</p>
          </div>
        </div>
        <div
          class="hidden items-center gap-4 border-t border-border px-5 py-2.5 text-xs text-muted-foreground sm:flex"
          aria-hidden="true"
        >
          <span class="inline-flex items-center gap-1.5"><kbd class={kbd}>↑</kbd><kbd class={kbd}>↓</kbd> to navigate</span>
          <span class="inline-flex items-center gap-1.5"><kbd class={kbd}>↵</kbd> to open</span>
          <span data-search-count class="ml-auto"></span>
        </div>
      </div>
    </form>
  </div>
</dialog>

<template data-search-result-template>
  <a class="group flex min-w-0 items-center gap-4 px-3 py-2.5 transition-colors hover:bg-muted focus-visible:bg-muted focus-visible:outline-none">
    <span class="min-w-0 flex-1">
      <span data-field="title" class="block truncate font-display text-[1.0625rem] leading-snug"></span>
      <span class="mt-0.5 flex items-center gap-1.5 overflow-hidden text-[0.8125rem] text-muted-foreground">
        <span data-field="type" class="shrink-0 font-medium text-primary"></span>
        <span aria-hidden="true">·</span>
        <span data-field="meta" class="truncate"></span>
      </span>
    </span>
    <svg
      viewBox="0 0 24 24"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
      class="shrink-0 text-muted-foreground opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100"
    >
      <path d="M5 12h14m-5-5 5 5-5 5" />
    </svg>
  </a>
</template>

<script>
  import { PALETTE_LIMIT, rankedPositions, resultCount, type SearchItem } from "@/lib/search";

  const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]");
  const panel = dialog?.querySelector<HTMLElement>("[data-search-panel]");
  const input = dialog?.querySelector<HTMLInputElement>("[data-search-input]");
  const body = dialog?.querySelector<HTMLElement>("[data-search-body]");
  const results = dialog?.querySelector<HTMLElement>("[data-search-results]");
  const empty = dialog?.querySelector<HTMLElement>("[data-search-empty]");
  const summary = dialog?.querySelector<HTMLElement>("[data-search-summary]");
  const count = dialog?.querySelector<HTMLElement>("[data-search-count]");
  const closeButtons = dialog?.querySelectorAll<HTMLButtonElement>("[data-search-close]");
  const template = document.querySelector<HTMLTemplateElement>("[data-search-result-template]");
  const toggles = Array.from(document.querySelectorAll<HTMLElement>("[data-search-toggle]"));

  const supportsDialog = typeof dialog?.showModal === "function";

  if (dialog && panel && input && body && results && empty && summary && template && supportsDialog) {
    let items: SearchItem[] = [];
    let indexRequest: Promise<SearchItem[]> | undefined;

    const loadIndex = () => {
      indexRequest ??= fetch("/search-index.json")
        .then((response) => {
          if (!response.ok) throw new Error("Search index unavailable");
          return response.json() as Promise<SearchItem[]>;
        })
        .then((loaded) => {
          if (Array.isArray(loaded)) items = loaded;
          return items;
        })
        .catch(() => {
          indexRequest = undefined;
          return items;
        });

      return indexRequest;
    };

    const resultRow = (item: SearchItem) => {
      const row = template.content.cloneNode(true) as DocumentFragment;
      const link = row.querySelector("a");
      if (link) link.href = item.href;
      row.querySelector<HTMLElement>('[data-field="title"]')!.textContent = item.title;
      row.querySelector<HTMLElement>('[data-field="type"]')!.textContent = item.type;
      row.querySelector<HTMLElement>('[data-field="meta"]')!.textContent = item.meta.join(" · ");
      return row;
    };

    const render = () => {
      const query = input.value.trim();
      body.hidden = !query;

      if (!query) {
        summary.textContent = "";
        results.replaceChildren();
        return;
      }

      const matches = rankedPositions(items, query).map((i) => items[i]);
      const label = `${resultCount(matches.length)} for “${query}”`;
      summary.textContent = `${label}.`;
      if (count) count.textContent = label;
      empty.hidden = matches.length > 0;
      results.replaceChildren(...matches.slice(0, PALETTE_LIMIT).map(resultRow));
    };

    const open = () => {
      if (!dialog.open) dialog.showModal();
      render();
      void loadIndex().then(render);
      window.requestAnimationFrame(() => input.focus());
    };

    const close = () => {
      if (dialog.open) dialog.close();
    };

    const links = () => Array.from(results.querySelectorAll<HTMLAnchorElement>("a"));

    toggles.forEach((toggle) => {
      toggle.addEventListener("click", (event) => {
        event.preventDefault();
        open();
      });
      // The index is usually needed a moment later; start early.
      toggle.addEventListener("pointerenter", () => void loadIndex());
      toggle.addEventListener("focus", () => void loadIndex());
    });

    closeButtons?.forEach((button) => button.addEventListener("click", close));
    // A search field eats the first Escape to clear itself; close on the first one.
    dialog.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      event.preventDefault();
      close();
    });
    dialog.addEventListener("click", (event) => {
      if (event.target instanceof Node && !panel.contains(event.target)) close();
    });
    results.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) close();
    });

    input.addEventListener("input", render);
    input.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown") return;
      const first = links()[0];
      if (!first) return;
      event.preventDefault();
      first.focus();
    });

    results.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
      const rows = links();
      const current = rows.indexOf(document.activeElement as HTMLAnchorElement);
      if (current === -1) return;

      event.preventDefault();
      if (event.key === "ArrowDown") (rows[current + 1] ?? rows[0]).focus();
      else if (current === 0) input.focus();
      else rows[current - 1].focus();
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target;
      const isTyping =
        target instanceof HTMLElement &&
        (target.matches("input, textarea, select") || target.isContentEditable);
      const isCommandKey = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k";
      const isSlashKey =
        event.key === "/" && !isTyping && !event.metaKey && !event.ctrlKey && !event.altKey;

      if (!isCommandKey && !isSlashKey) return;
      event.preventDefault();

      if (dialog.open && isCommandKey) close();
      else open();
    });
  }
</script>
