---
import LocalIcon, { type LocalIconName } from "@/components/LocalIcon.astro";
import { siteConfig } from "@/config/site";

/**
 * The share sheet: the common targets, the long tail folded behind "More",
 * and the page link with a copy button. Every target is a plain link, so the
 * sheet works even where the clipboard is unavailable.
 *
 * One sheet per page, opened by any number of `ShareButton`s.
 */
interface Props {
  title: string;
  /** Absolute URL. Defaults to the canonical URL of the page being rendered. */
  url?: string;
}

const { title, url } = Astro.props;

const shareUrl = url ?? new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const link = encodeURIComponent(shareUrl);
const text = encodeURIComponent(title);

interface Target {
  label: string;
  icon: LocalIconName;
  brand: string;
  href: string;
}

/* Brand colours are how people find their service without reading labels. */
const targets: Target[] = [
  { label: "WhatsApp", icon: "whatsapp", brand: "#1eb355", href: `https://api.whatsapp.com/send?text=${text}%20${link}` },
  { label: "Facebook", icon: "facebook", brand: "#1877f2", href: `https://www.facebook.com/sharer/sharer.php?u=${link}` },
  { label: "Pinterest", icon: "pinterest", brand: "#d5001f", href: `https://pinterest.com/pin/create/button/?url=${link}&description=${text}` },
  { label: "Email", icon: "envelope", brand: "#c2413f", href: `mailto:?subject=${text}&body=${link}` },
  { label: "X", icon: "twitter-x", brand: "#0e0e0c", href: `https://x.com/intent/tweet?text=${text}&url=${link}` },
  { label: "Bluesky", icon: "bluesky", brand: "#1185fe", href: `https://bsky.app/intent/compose?text=${text}%20${link}` },
  { label: "Threads", icon: "threads", brand: "#0e0e0c", href: `https://www.threads.net/intent/post?text=${text}%20${link}` },
];

const extraTargets: Target[] = [
  { label: "Telegram", icon: "telegram", brand: "#2596d8", href: `https://t.me/share/url?url=${link}&text=${text}` },
  { label: "LinkedIn", icon: "linkedin", brand: "#0a66c2", href: `https://www.linkedin.com/sharing/share-offsite/?url=${link}` },
  { label: "Reddit", icon: "reddit", brand: "#e03d00", href: `https://www.reddit.com/submit?url=${link}&title=${text}` },
];
---

<dialog class="sheet" aria-labelledby="share-sheet-title" data-share-sheet>
  <div class="sheet-panel">
    <div class="flex items-center justify-between gap-4">
      <h2 id="share-sheet-title" class="font-display text-2xl leading-none">Share this story</h2>
      <button
        type="button"
        class="grid h-9 w-9 place-items-center text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        aria-label="Close"
        data-share-close
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <ul class="sheet-targets">
      {
        targets.map((target) => (
          <li>
            <a class="sheet-target" style={`--brand-mark:${target.brand}`} href={target.href} target="_blank" rel="noreferrer" data-share-target>
              <span class="sheet-icon">
                <LocalIcon name={target.icon} className="h-5 w-5" />
              </span>
              <span>{target.label}</span>
            </a>
          </li>
        ))
      }
      <li data-share-more-item>
        <button type="button" class="sheet-target sheet-target-quiet" data-share-more>
          <span class="sheet-icon">
            <LocalIcon name="three-dots" className="h-5 w-5" />
          </span>
          <span>More</span>
        </button>
      </li>
      {
        extraTargets.map((target) => (
          <li hidden data-share-extra>
            <a class="sheet-target" style={`--brand-mark:${target.brand}`} href={target.href} target="_blank" rel="noreferrer" data-share-target>
              <span class="sheet-icon">
                <LocalIcon name={target.icon} className="h-5 w-5" />
              </span>
              <span>{target.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-6 border-t border-border pt-5">
      <label for="share-sheet-url" class="text-sm text-muted-foreground">Page link</label>
      <div class="mt-2 flex items-stretch border border-border bg-muted/50">
        <input
          id="share-sheet-url"
          class="min-w-0 flex-1 bg-transparent px-3 py-2.5 text-sm text-muted-foreground outline-none"
          type="text"
          readonly
          value={shareUrl}
          data-share-url
        />
        <button
          type="button"
          class="inline-flex shrink-0 items-center gap-2 border-l border-border bg-background px-4 text-sm font-semibold transition-colors hover:text-primary"
          data-share-copy
          data-copy-url={shareUrl}
        >
          <LocalIcon name="clipboard" className="h-3.5 w-3.5" />
          <span aria-live="polite" data-share-copy-label>Copy</span>
        </button>
      </div>
    </div>
  </div>
</dialog>

<script>
  const sheet = document.querySelector<HTMLDialogElement>("[data-share-sheet]");

  if (sheet && typeof sheet.showModal === "function") {
    let opener: HTMLElement | null = null;

    const close = () => {
      if (sheet.open) sheet.close();
    };

    document.querySelectorAll<HTMLButtonElement>("[data-share-open]").forEach((button) => {
      button.addEventListener("click", () => {
        opener = button;
        if (!sheet.open) sheet.showModal();
      });
    });

    sheet.addEventListener("close", () => {
      opener?.focus({ preventScroll: true });
      opener = null;
    });

    // The panel covers everything else, so a click on the dialog itself is the backdrop.
    sheet.addEventListener("click", (event) => {
      if (event.target === sheet) close();
    });

    sheet.querySelectorAll("[data-share-close], [data-share-target]").forEach((el) => {
      el.addEventListener("click", close);
    });

    sheet.querySelector<HTMLButtonElement>("[data-share-more]")?.addEventListener("click", () => {
      sheet.querySelectorAll<HTMLElement>("[data-share-extra]").forEach((item) => {
        item.hidden = false;
      });
      const moreItem = sheet.querySelector<HTMLElement>("[data-share-more-item]");
      if (moreItem) moreItem.hidden = true;
      sheet.querySelector<HTMLElement>("[data-share-extra] a")?.focus();
    });

    const copyButton = sheet.querySelector<HTMLButtonElement>("[data-share-copy]");
    const copyLabel = sheet.querySelector<HTMLElement>("[data-share-copy-label]");
    const field = sheet.querySelector<HTMLInputElement>("[data-share-url]");
    let restore: number | undefined;

    copyButton?.addEventListener("click", async () => {
      const url = copyButton.dataset.copyUrl;
      if (!url || !copyLabel) return;

      let message = "Copied";
      try {
        if (!navigator.clipboard?.writeText) throw new Error("Clipboard unavailable");
        await navigator.clipboard.writeText(url);
      } catch {
        field?.select();
        message = "Press Ctrl+C";
      }

      copyLabel.textContent = message;
      window.clearTimeout(restore);
      restore = window.setTimeout(() => {
        copyLabel.textContent = "Copy";
      }, 2400);
    });
  }
</script>

<style>
  .sheet {
    position: fixed;
    inset: 0;
    display: grid;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    place-items: center;
    margin: 0;
    padding: 1.25rem;
    border: 0;
    background: transparent;
    color: var(--foreground);
  }

  .sheet:not([open]) {
    display: none;
  }

  .sheet::backdrop {
    background: oklch(0.14 0.006 240 / 55%);
    backdrop-filter: blur(4px);
  }

  .sheet-panel {
    width: 100%;
    max-width: 26rem;
    max-height: calc(100dvh - 2.5rem);
    overflow-y: auto;
    padding: 1.5rem;
    background: var(--background);
    box-shadow: 0 30px 80px -20px oklch(0.14 0.006 240 / 40%);
  }

  .sheet-targets {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.1rem 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 26rem) {
    .sheet-targets {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .sheet-targets li[hidden] {
    display: none;
  }

  .sheet-target {
    display: grid;
    width: 100%;
    gap: 0.5rem;
    justify-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
  }

  .sheet-target:hover {
    color: var(--foreground);
  }

  .sheet-icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    background: var(--brand-mark, var(--muted));
    color: #fff;
    transition: transform 0.2s ease;
  }

  .sheet-target-quiet .sheet-icon {
    background: var(--muted);
    color: var(--foreground);
  }

  .sheet-target:hover .sheet-icon {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet-icon,
    .sheet-target:hover .sheet-icon {
      transform: none;
      transition: none;
    }
  }
</style>
